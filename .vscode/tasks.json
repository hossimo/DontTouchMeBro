{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "process",
            "command": "cargo",
            "args": ["build"],
            "problemMatcher": "$rustc",
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "test",
            "type": "process",
            "command": "cargo",
            "args": ["test"],
            "problemMatcher": "$rustc",
            "group": { "kind": "test", "isDefault": true }
        },
        {
            "label": "run-elevated",
            "type": "shell",
            "command": "Start-Process",
            "args": [
                "-FilePath",
                "'${workspaceFolder}\\target\\debug\\DontTouchMeBro.exe'",
                "-Verb",
                "RunAs"
            ],
            "dependsOn": "build",
            "problemMatcher": []
        },
        {
            "label": "run-configure-elevated",
            "type": "shell",
            "command": "Start-Process",
            "args": [
                "-FilePath",
                "'${workspaceFolder}\\target\\debug\\DontTouchMeBro.exe'",
                "-ArgumentList",
                "--configure",
                "-Verb",
                "RunAs"
            ],
            "dependsOn": "build",
            "problemMatcher": []
        }
    ]
}
