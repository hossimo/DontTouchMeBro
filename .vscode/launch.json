{
    "version": "0.2.0",
    "configurations": [
        {
            // The exe requires Administrator, so start VS Code elevated to debug it.
            "name": "Debug DontTouchMeBro (tray)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/DontTouchMeBro.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "build"
        },
        {
            "name": "Debug DontTouchMeBro (Configure window)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/DontTouchMeBro.exe",
            "args": ["--configure"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "build"
        }
    ]
}
